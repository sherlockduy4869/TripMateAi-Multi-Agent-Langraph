# =============================================================================
# General-purpose .gitignore
# Covers: OS files, editors/IDEs, secrets, logs, Python, Node.js, Java,
#         .NET, build output, caches, and common tooling.
# Tip: delete the sections you don't need to keep the file lean.
# =============================================================================

# -----------------------------------------------------------------------------
# CLAUDE
# -----------------------------------------------------------------------------
.claude


# -----------------------------------------------------------------------------
# Secrets & local configuration (NEVER commit these)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
secrets.json
secrets.yml
secrets.yaml
credentials.json
service-account*.json
*.secret
*.secrets
config.local.*
settings.local.*
*.local

# -----------------------------------------------------------------------------
# Operating system files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.fuse_hidden*
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# Editors & IDEs
# -----------------------------------------------------------------------------
# VS Code (keep shared team settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
*.code-workspace

# JetBrains (IntelliJ, PyCharm, WebStorm, Rider...)
.idea/
*.iml
*.iws
*.ipr
out/
cmake-build-*/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Vim / Emacs / Sublime
*.swp
*.swo
*.swn
Session.vim
.netrwhist
\#*\#
.\#*
*.sublime-workspace
*.sublime-project

# -----------------------------------------------------------------------------
# Logs, temp files & backups
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej
*.old
tmp/
temp/

# -----------------------------------------------------------------------------
# Build output & distribution
# -----------------------------------------------------------------------------
build/
dist/
target/
bin/
obj/
out/
*.egg-info/
*.egg
*.whl
.eggs/
*.tar.gz
*.zip
*.7z
*.rar

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.python-version
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.ipynb_checkpoints/
profile_default/
ipython_config.py
instance/
.webassets-cache
.scrapy
docs/_build/
.pybuilder/
celerybeat-schedule
celerybeat.pid
poetry.toml
.pdm-python
.pdm-build/
__pypackages__/

# -----------------------------------------------------------------------------
# Node.js / JavaScript / TypeScript
# -----------------------------------------------------------------------------
node_modules/
jspm_packages/
bower_components/
.npm
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.eslintcache
.stylelintcache
*.tsbuildinfo
.next/
.nuxt/
.svelte-kit/
.angular/
.parcel-cache/
.turbo/
.vercel/
.netlify/
.cache/
.temp/
storybook-static/
coverage/
.nyc_output/
lib-cov/

# -----------------------------------------------------------------------------
# Java / Kotlin / Gradle / Maven
# -----------------------------------------------------------------------------
*.class
*.jar
*.war
*.ear
hs_err_pid*
.gradle/
!gradle/wrapper/gradle-wrapper.jar
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties

# -----------------------------------------------------------------------------
# .NET / C#
# -----------------------------------------------------------------------------
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/
*.nupkg
*.snupkg
.nuget/
packages/
TestResults/
*.dll
*.exe
*.pdb
project.lock.json

# -----------------------------------------------------------------------------
# Go / Rust / Ruby / PHP
# -----------------------------------------------------------------------------
# Go
*.test
*.out
vendor/
go.work

# Rust
**/*.rs.bk
Cargo.lock.bak

# Ruby
.bundle/
*.gem
.byebug_history

# PHP
/vendor/
composer.phar
.phpunit.result.cache

# -----------------------------------------------------------------------------
# Docker, Terraform & infrastructure
# -----------------------------------------------------------------------------
docker-compose.override.yml
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!example.tfvars
.terragrunt-cache/
.vagrant/

# -----------------------------------------------------------------------------
# Databases & local data
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.dump
dump.rdb

# -----------------------------------------------------------------------------
# Data files & office documents (uncomment if you don't want them versioned)
# -----------------------------------------------------------------------------
# *.csv
# *.xlsx
# *.xls
# data/
# datasets/

# Lock/temp files created by Office apps
~$*
.~lock.*#

# -----------------------------------------------------------------------------
# Machine learning artifacts
# -----------------------------------------------------------------------------
*.h5
*.hdf5
*.ckpt
*.pt
*.pth
*.onnx
*.pkl
*.pickle
wandb/
mlruns/

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
.sass-cache/
*.pid
*.seed
*.pid.lock
.history/
.terraform.lock.hcl.bak